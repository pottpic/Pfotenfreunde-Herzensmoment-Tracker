{
  "manifest_version": 3,
  "name": "Pottpic Deck",
  "version": "1.0",
  "description": "Alle Seiten, die ich täglich brauch – ein Klick und offen.",
  "action": {
    "default_popup": "deck.html",
    "default_title": "Pottpic Deck",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "activeTab"]
}
